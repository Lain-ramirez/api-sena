<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuracion de las acciones Run y Debug de NetBeans para este proyecto Maven.

    Sin este archivo NetBeans decide por su cuenta la clase principal y suele pasar
    -Dexec.mainClass=com.crud.app.App por linea de comandos, lo que ejecuta la version
    de consola y pisa la propiedad exec.mainClass definida en el pom.xml.

    Aqui se fija com.crud.app.gui.CrudFrame para que el boton Run (F6) abra la ventana.
    Para la version de consola: clic derecho en App.java > Run File.
-->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs></exec.vmArgs>
            <exec.appArgs></exec.appArgs>
            <exec.mainClass>com.crud.app.gui.CrudFrame</exec.mainClass>
            <exec.executable>java</exec.executable>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</exec.vmArgs>
            <exec.appArgs></exec.appArgs>
            <exec.mainClass>com.crud.app.gui.CrudFrame</exec.mainClass>
            <exec.executable>java</exec.executable>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
